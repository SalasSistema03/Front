{
  "name": "salas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "clean-assets": "node -e \"const fs=require('fs'); const path='../../backEnd/public/assets'; if(fs.existsSync(path)){fs.rmSync(path,{recursive:true,force:true});} fs.mkdirSync(path,{recursive:true});\"",
    "build": "npm run clean-assets && vite build && npm run actualizar-blade",
    "actualizar-blade": "del ..\\..\\backEnd\\resources\\views\\app.blade.php /Q 2>nul & ren ..\\..\\backEnd\\public\\index.html app.blade.php & move ..\\..\\backEnd\\public\\app.blade.php ..\\..\\backEnd\\resources\\views\\",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "pinia": "^4.1.0",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "~10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "sass-embedded": "^1.106.1",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5"
  }
}
